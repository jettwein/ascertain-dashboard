# Copy to .env.local and fill in.
# These are consumed by scripts/snapshot/fetch.ts.

# Linear personal API key — https://linear.app/settings/api
LINEAR_API_KEY=

# Notion internal integration token — https://www.notion.so/my-integrations
# The integration must be shared with the pages it needs to read.
NOTION_API_KEY=

# Slack bot token (xoxb-...) with scopes:
#   channels:history, groups:history, users:read, channels:read, groups:read
SLACK_BOT_TOKEN=
