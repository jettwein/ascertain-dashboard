{
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(gh:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "test -f scripts/hooks/pre-tool-use.sh && bash scripts/hooks/pre-tool-use.sh || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "test -f scripts/hooks/post-tool-use.sh && bash scripts/hooks/post-tool-use.sh || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test -f scripts/hooks/notify.sh && bash scripts/hooks/notify.sh || true"
          }
        ]
      }
    ],
    "TeammateIdle": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test -f scripts/hooks/teammate-idle.sh && bash scripts/hooks/teammate-idle.sh || true"
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "test -f scripts/hooks/task-completed.sh && bash scripts/hooks/task-completed.sh || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "test -f scripts/session-start.sh && bash scripts/session-start.sh || true"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "test -f scripts/session-start.sh && bash scripts/session-start.sh || true"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "test -f scripts/session-compact.sh && bash scripts/session-compact.sh || true"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true
  }
}
